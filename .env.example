# ---------------------------------------------------------------------------
# Copy this file to .env and fill it in. NEVER commit .env.
# ---------------------------------------------------------------------------

# --- WhatsApp Cloud API (Meta) ---------------------------------------------
# From developers.facebook.com > your app > WhatsApp > API Setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# You invent this string, then paste the same one into Meta's webhook setup
WHATSAPP_VERIFY_TOKEN=pick-any-long-random-string
# App Settings > Basic > App Secret. Used to verify webhook signatures.
WHATSAPP_APP_SECRET=

# --- Who runs this ----------------------------------------------------------
OWNER_NAME=Samarth
# Your own number in international format, no +. You get a ping on every lead.
OWNER_WHATSAPP=6596109538

# --- OpenRouter (free-text fallback) ---------------------------------------
# Get a key at openrouter.ai/keys. Never paste it anywhere but this file.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# --- Google Calendar (optional) --------------------------------------------
# Leave blank to run without calendar. Slots are still offered and bookings
# still recorded; they just are not checked against your real availability.
# Run `npm run auth:google` to obtain a refresh token.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# --- Booking rules ----------------------------------------------------------
TIMEZONE=Asia/Singapore
# Comma-separated 24h start times. 2-4pm is when shop owners are actually free.
SLOT_TIMES=14:00,15:00,16:00
SLOT_MINUTES=20
# 1=Mon .. 6=Sat. Shops open Saturday; Sunday is usually dead.
BOOKING_DAYS=1,2,3,4,5,6
# How many days ahead to offer
LOOKAHEAD_DAYS=6
# Do not offer a slot sooner than this many hours from now
MIN_LEAD_HOURS=3

# --- Server -----------------------------------------------------------------
PORT=3000
# Protects GET /leads
ADMIN_TOKEN=pick-another-long-random-string
