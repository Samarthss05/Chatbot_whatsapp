# Copy to .env. Never commit credentials. For a safe preview, run npm run demo instead.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DRY_RUN=0
DB_FILE=./data/ledgerbot.db
# Generate each secret separately: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
GRAPH_VERSION=v21.0
OWNER_NAME=Samarth
# Optional: your personal number, digits only. Incoming messages from it bypass automation.
OWNER_WHATSAPP=
# Optional HTTPS automation endpoint accepting {text, wa_id}; retries on failure.
NOTIFY_WEBHOOK=
# LLM is optional. Add BOTH values when ready; choose a model supporting strict JSON schema.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
LLM_MIN_CONFIDENCE=0.8
# Optional as a complete set. Once configured, Calendar errors block automated bookings.
# Google OAuth redirect: http://127.0.0.1:5555/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
TIMEZONE=Asia/Singapore
SLOT_TIMES=14:00,15:00,16:00
SLOT_MINUTES=20
BUFFER_MINUTES=10
BOOKING_DAYS=1,2,3,4,5,6
LOOKAHEAD_DAYS=6
MIN_LEAD_HOURS=3
OFFER_TTL_MINUTES=30
JOB_MAX_ATTEMPTS=5
WORKER_POLL_MS=500
